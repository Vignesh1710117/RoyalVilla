@using RoyalVilla.DTO
@using RoyalVillaWeb
@using RoyalVillaWeb.ViewModels
@model RoyalVillaWeb.ViewModels.VillaPageObjects

@{
    ViewData["Title"] = "Discover Luxury Villas";
    var villas = Model?.villas ?? new List<VillaDTO>();
    var query = Model?.villaQuery ?? new RoyalVillaWeb.ViewModels.VillaQueryParameters();
    var pg = Model?.Pagination;
    if (pg == null || (pg.TotalCount == 0 && villas.Any()))
    {
        // Headers missing: fall back to what we have so the page still renders
        pg = new PaginationInfo { CurrentPage = 1, PageSize = villas.Count, TotalCount = villas.Count, TotalPages = 1 };
    }
    var firstItem = pg.TotalCount == 0 ? 0 : ((pg.CurrentPage - 1) * pg.PageSize) + 1;
    var lastItem = villas.Any() ? firstItem + villas.Count - 1 : 0;
    var shownCount = ((pg.CurrentPage - 1) * pg.PageSize) + villas.Count;
    var remaining = Math.Max(0, pg.TotalCount - shownCount);
    var nextBatch = Math.Min(pg.PageSize, remaining);

    var slides = new[]
    {
        (Css: "",          Icon: "bi-stars",          Tag: "Welcome to RoyalVilla",  Title: "Find Your Own<br />Piece of Paradise",
         Text: "Discover thoughtfully selected villas where comfort, privacy and unforgettable experiences come together."),
        (Css: "slide-two", Icon: "bi-gem",            Tag: "Comfort meets elegance", Title: "A Stay Worth<br />Remembering",
         Text: "Enjoy the space, amenities and comfort you need to make every getaway feel special."),
        (Css: "slide-three", Icon: "bi-calendar-heart", Tag: "Your next getaway",    Title: "Make Room for<br />Beautiful Memories",
         Text: "Explore our available properties and find the right villa for your next escape.")
    };
}

<div class="rv-home">

    <!-- Hero carousel -->
    <section class="rv-hero" aria-label="Featured">
        <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="6000">

            <div class="carousel-indicators">
                @for (var i = 0; i < slides.Length; i++)
                {
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"
                            aria-current="@(i == 0 ? "true" : "false")"
                            aria-label="Slide @(i + 1)"></button>
                }
            </div>

            <div class="carousel-inner">
                @for (var i = 0; i < slides.Length; i++)
                {
                    var s = slides[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="carousel-slide @s.Css">
                            <div class="rv-hero-content">
                                <span class="rv-hero-eyebrow"><i class="bi @s.Icon me-2"></i>@s.Tag</span>
                                @if (i == 0)
                                {
                                    <h1>@Html.Raw(s.Title)</h1>
                                }
                                else
                                {

                                    <h2 class="h1 rv-hero-heading">@Html.Raw(s.Title)</h2>
                                }
                                <p>@s.Text</p>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" aria-label="Previous slide">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" aria-label="Next slide">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
            </button>
        </div>
    </section>

    <!-- One shared search panel for every slide -->
    <div class="rv-search-wrap">
        <div class="rv-search-shell" id="rvSearchBox">
            <div class="rv-search-tabs" role="tablist" aria-label="Villa search options">
                <button type="button" class="rv-search-tab active" data-mode="search" role="tab" aria-selected="true">
                    <i class="bi bi-search"></i>Search
                </button>
                <button type="button" class="rv-search-tab" data-mode="filters" role="tab" aria-selected="false">
                    <i class="bi bi-sliders"></i>Filters
                </button>
            </div>

            <form asp-controller="Home" asp-action="Index" method="get" id="rvSearchForm">
                <input type="hidden" name="Page" value="1" />
                <input type="hidden" name="PageSize" value="@query.PageSize" />

                <div id="rvSearchPanel" data-panel="search">
                    <div class="rv-search-input-row">
                        <label class="rv-search-input-wrap">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input type="text" name="FilterQuery" value="@query.FilterQuery"
                                   class="rv-search-input" placeholder="Search villas by name"
                                   aria-label="Search villas by name" />
                        </label>
                        <input type="hidden" name="FilterBy" value="name" />
                        <button type="submit" class="rv-search-submit">Search villas</button>
                    </div>
                    <div class="rv-search-help">Search our collection by property name.</div>
                </div>

                <div id="rvFilterPanel" class="rv-filter-panel" data-panel="filters" hidden>
                    <div class="rv-filter-grid">
                        <div class="rv-filter-field">
                            <label for="rvFilterBy">Filter by</label>
                            <select id="rvFilterBy" name="FilterBy" class="form-select" disabled>
                                <option value="name" selected="@(query.FilterBy == "name")">Villa name</option>
                                <option value="details" selected="@(query.FilterBy == "details")">Details</option>
                                <option value="rate" selected="@(query.FilterBy == "rate")">Exact rate</option>
                                <option value="minrate" selected="@(query.FilterBy == "minrate")">Minimum rate</option>
                                <option value="maxrate" selected="@(query.FilterBy == "maxrate")">Maximum rate</option>
                                <option value="occupancy" selected="@(query.FilterBy == "occupancy")">Occupancy</option>
                                <option value="sqft" selected="@(query.FilterBy == "sqft")">Square feet</option>
                            </select>
                        </div>

                        <div class="rv-filter-field">
                            <label for="rvFilterValue">Filter value</label>
                            <input id="rvFilterValue" type="text" name="FilterQuery" value="@query.FilterQuery"
                                   class="form-control" placeholder="Enter a value" disabled />
                        </div>

                        <div class="rv-filter-field rv-sort-field">
                            <label for="rvSort">Sort results</label>
                            <select id="rvSort" class="form-select">
                                <option value="">Recommended</option>
                                <option value="rate|asc">Price: low to high</option>
                                <option value="rate|desc">Price: high to low</option>
                                <option value="name|asc">Villa name: A to Z</option>
                                <option value="name|desc">Villa name: Z to A</option>
                                <option value="occupancy|desc">Guest capacity: highest</option>
                                <option value="occupancy|asc">Guest capacity: lowest</option>
                                <option value="sqft|desc">Area: largest first</option>
                                <option value="sqft|asc">Area: smallest first</option>
                            </select>
                            <input type="hidden" name="SortBy" id="rvSortBy" value="@query.SortBy" disabled />
                            <input type="hidden" name="SortOrder" id="rvSortOrder" value="@query.SortOrder" disabled />
                        </div>
                    </div>

                    <div class="rv-filter-actions">
                        <a asp-controller="Home" asp-action="Index" class="rv-filter-clear">Clear filters</a>
                        <button type="submit" class="rv-search-submit">Apply filters</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Highlights -->
    <div class="container">
        <div class="rv-intro-strip">
            <div class="row g-2">
                <div class="col-md-4">
                    <div class="rv-intro-item">
                        <div class="rv-intro-icon"><i class="bi bi-house-heart"></i></div>
                        <div><strong>Handpicked villas</strong><small>Spaces for your perfect stay</small></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="rv-intro-item">
                        <div class="rv-intro-icon"><i class="bi bi-people"></i></div>
                        <div><strong>Room for everyone</strong><small>Find a villa that fits your group</small></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="rv-intro-item">
                        <div class="rv-intro-icon"><i class="bi bi-calendar-check"></i></div>
                        <div><strong>Plan your stay</strong><small>Explore properties and amenities</small></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Villa listings -->
    <section class="container rv-listings" id="villa-listings">

        <div class="text-center mb-5">
            <h2 class="rv-section-title mb-3">Explore our villas</h2>
            <p class="rv-section-subtitle">
                Spaces designed for relaxation, comfort and meaningful moments with the people who matter.
            </p>
            <div class="mt-4">
                <span class="rv-listing-count">
                    <i class="bi bi-house-door"></i>
                    @pg.TotalCount @(pg.TotalCount == 1 ? "property" : "properties")
                </span>
            </div>
        </div>

        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rv-alert mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!villas.Any())
        {
            <div class="rv-empty-state">
                <div class="rv-empty-icon"><i class="bi bi-house"></i></div>
                <h3 class="fw-bold mb-2">No villas found</h3>
                <p class="text-muted mb-3">Try a different search or clear your filters.</p>
                <a asp-controller="Home" asp-action="Index" class="btn rv-details-btn">Show all villas</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="villaGrid">
                @foreach (var villa in villas)
                {
                    <div class="col">
                        <article class="rv-villa-card">
                            <div class="rv-villa-image-wrap">
                                @if (!string.IsNullOrWhiteSpace(villa.ImageUrl))
                                {
                                    <img src="@SD.getImageURL(villa.ImageUrl)" class="rv-villa-image" alt="@villa.Name" loading="lazy" />
                                }
                                else
                                {
                                    <div class="rv-image-placeholder"><i class="bi bi-house-heart"></i></div>
                                }
                                <div class="rv-price-badge">₹@villa.Rate.ToString("N0") <span>/ night</span></div>
                            </div>

                            <div class="rv-villa-card-body">
                                <h3 class="rv-villa-name">@villa.Name</h3>
                                <p class="rv-villa-description">
                                    @(string.IsNullOrWhiteSpace(villa.Details)
                                        ? "Discover this property and explore its features and amenities."
                                        : villa.Details)
                                </p>

                                <div class="rv-villa-features">
                                    <span><i class="bi bi-people-fill"></i>@villa.Occupancy guests</span>
                                    <span><i class="bi bi-rulers"></i>@villa.Sqft.ToString("N0") sq.ft.</span>
                                </div>

                                <div class="d-grid gap-2 mt-2">
                                    <a asp-controller="VillaAmenities" asp-action="Details" asp-route-id="@villa.Id" class="btn rv-details-btn">
                                        <i class="bi bi-arrow-up-right-square me-2"></i>View villa details
                                    </a>
                                    <a href="mailto:vignesh@gmail.com" class="btn rv-contact-btn">
                                        <i class="bi bi-envelope me-2"></i>Contact us
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>

            <div class="rv-loadmore">
                @if (remaining > 0)
                {
                    <button type="button" id="rvLoadMoreBtn" class="rv-loadmore-btn"
                            data-next="@(pg.CurrentPage + 1)" data-size="@pg.PageSize"
                            data-total="@pg.TotalCount" data-shown="@shownCount">
                        <span class="rv-loadmore-label">Load next @nextBatch</span>
                    </button>
                }
                <p id="rvLoadMoreStatus" class="rv-loadmore-status" aria-live="polite">
                    Displaying @shownCount of @pg.TotalCount
                </p>
            </div>

            <!-- Statistics -->
            <section class="rv-stats" aria-labelledby="rvStatsTitle">
                <div class="text-center mb-4">
                    <h3 class="rv-section-title mb-0" id="rvStatsTitle">RoyalVilla at a glance</h3>
                </div>
                <div class="row g-3 text-center">
                    <div class="col-6 col-lg-3">
                        <div class="rv-stat-item">
                            <div class="rv-stat-icon"><i class="bi bi-houses"></i></div>
                            <div class="rv-stat-value">@pg.TotalCount</div>
                            <p class="rv-stat-label">Total villas</p>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="rv-stat-item">
                            <div class="rv-stat-icon"><i class="bi bi-currency-rupee"></i></div>
                            <div class="rv-stat-value">₹@villas.Min(v => v.Rate).ToString("N0")</div>
                            <p class="rv-stat-label">Starting price / night</p>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="rv-stat-item">
                            <div class="rv-stat-icon"><i class="bi bi-people"></i></div>
                            <div class="rv-stat-value">@villas.Max(v => v.Occupancy)</div>
                            <p class="rv-stat-label">Largest guest capacity</p>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="rv-stat-item">
                            <div class="rv-stat-icon"><i class="bi bi-bounding-box"></i></div>
                            <div class="rv-stat-value">@villas.Sum(v => v.Sqft).ToString("N0")</div>
                            <p class="rv-stat-label">Combined sq. ft.</p>
                        </div>
                    </div>
                </div>
            </section>
        }

        <div class="text-center mt-5 rv-bottom-note">
            <i class="bi bi-leaf me-1"></i>Find your comfort. Create your memories. Stay with RoyalVilla.
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            const box = document.getElementById("rvSearchBox");
            const tabs = box.querySelectorAll(".rv-search-tab");
            const panels = box.querySelectorAll("[data-panel]");
            const sortSelect = document.getElementById("rvSort");
            const sortBy = document.getElementById("rvSortBy");
            const sortOrder = document.getElementById("rvSortOrder");

            function activate(mode) {
                tabs.forEach(t => {
                    const on = t.dataset.mode === mode;
                    t.classList.toggle("active", on);
                    t.setAttribute("aria-selected", on);
                });
                panels.forEach(p => {
                    const hide = p.dataset.panel !== mode;
                    p.hidden = hide;
                    // disabled inputs are not submitted, so only the visible panel posts its values
                    p.querySelectorAll("input, select").forEach(el => {
                        if (el !== sortSelect) el.disabled = hide;
                    });
                });
            }

            tabs.forEach(t => t.addEventListener("click", () => activate(t.dataset.mode)));

            sortSelect.value = sortBy.value && sortOrder.value ? sortBy.value + "|" + sortOrder.value : "";
            sortSelect.addEventListener("change", () => {
                const [by, order] = sortSelect.value.split("|");
                sortBy.value = by || "";
                sortOrder.value = order || "";
            });

            // Open on Filters tab when the page was loaded with a sort or non-name filter
            const startInFilters = (sortBy.value && sortOrder.value) ||
                ("@query.FilterBy" && "@query.FilterBy" !== "name" && "@query.FilterBy" !== "");
            activate(startInFilters ? "filters" : "search");
        })();
    </script>

    <script>
        (function () {
            const btn = document.getElementById("rvLoadMoreBtn");
            if (!btn) return;

            const grid = document.getElementById("villaGrid");
            const status = document.getElementById("rvLoadMoreStatus");
            const label = btn.querySelector(".rv-loadmore-label");
            const total = parseInt(btn.dataset.total, 10);
            const size = parseInt(btn.dataset.size, 10);
            let nextPage = parseInt(btn.dataset.next, 10);
            let shown = parseInt(btn.dataset.shown, 10);

            btn.addEventListener("click", async () => {
                btn.disabled = true;
                label.textContent = "Loading...";
                try {
                    // same URL as the current page, so search, filter and sort carry over
                    const params = new URLSearchParams(window.location.search);
                    params.set("Page", nextPage);
                    params.set("PageSize", size);

                    const res = await fetch(window.location.pathname + "?" + params.toString());
                    if (!res.ok) throw new Error("Request failed");

                    const doc = new DOMParser().parseFromString(await res.text(), "text/html");
                    const cards = doc.querySelectorAll("#villaGrid > .col");
                    cards.forEach(c => grid.appendChild(document.importNode(c, true)));

                    shown += cards.length;
                    nextPage++;
                    status.textContent = "Displaying " + shown + " of " + total;

                    if (cards.length === 0 || shown >= total) {
                        btn.remove();
                    } else {
                        label.textContent = "Load next " + Math.min(size, total - shown);
                        btn.disabled = false;
                    }
                } catch (e) {
                    label.textContent = "Could not load. Try again";
                    btn.disabled = false;
                }
            });
        })();
    </script>
}
