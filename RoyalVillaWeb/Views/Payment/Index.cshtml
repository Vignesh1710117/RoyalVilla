@model RoyalVillaWeb.ViewModels.PaymentApiViewModel

@{
    ViewData["Title"] = "Payment";
}

<div class="container mt-5">
    <div class="card shadow-sm mx-auto" style="max-width: 500px;">
        <div class="card-body text-center p-4">
            <h3 class="mb-3">Complete Your Payment</h3>

            <p class="text-muted">Secure payment powered by Razorpay</p>

            <h4 class="mb-4">
                Amount: @Model.Currency @Model.amount.ToString("N2")
            </h4>

            <button type="button"
                    id="payNowButton"
                    class="btn btn-primary btn-lg">
                <i class="bi bi-lock-fill"></i>
                Pay Now
            </button>

            <div id="paymentMessage" class="mt-3" role="status"></div>
        </div>
    </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
    const verifyUrl = '@Url.Action("Verify", "Payment")';

    document.getElementById("payNowButton").addEventListener("click", function () {
        const button = this;
        button.disabled = true;

        const options = {
            key: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.keyId)),
            amount: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.amount)),
            currency: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Currency)),
            name: "RoyalVilla",
            description: "Villa Booking Payment",
            order_id: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OrderId)),

            handler: async function (response) {
                const message = document.getElementById("paymentMessage");
                message.textContent = "Verifying your payment...";

                try {
                    const result = await fetch(verifyUrl, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            razorpayOrderId: response.razorpay_order_id,
                            razorpayPaymentId: response.razorpay_payment_id,
                            razorpaySignature: response.razorpay_signature
                        })
                    });

                    if (result.ok) {
                        message.textContent = "Payment verified successfully!";
                        window.location.href = '@Url.Action("Success", "Payment")';
                    } else {
                        message.textContent =
                            "Payment verification failed. Please contact support.";
                        button.disabled = false;
                    }
                } catch (error) {
                    console.error("Verification request failed:", error);
                    message.textContent =
                        "Unable to verify the payment right now. Please check your booking status before retrying.";
                    button.disabled = false;
                }
            },

            modal: {
                ondismiss: function () {
                    button.disabled = false;
                    document.getElementById("paymentMessage").textContent =
                        "Payment window closed.";
                }
            },

            theme: {
                color: "#0d6efd"
            }
        };

        const razorpay = new Razorpay(options);

        razorpay.on("payment.failed", function (response) {
            console.error("Razorpay payment failed:", response.error);

            document.getElementById("paymentMessage").textContent =
                "Payment failed. Please try again.";

            button.disabled = false;
        });

        razorpay.open();
    });
</script>