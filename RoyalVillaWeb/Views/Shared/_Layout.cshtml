<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1e3829" />
    <title>@ViewData["Title"] - BookMyVilla</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RoyalVillaWeb.styles.css" asp-append-version="true" />
</head>
<body class="royal-body">
    <a class="rv-skip-link" href="#main">Skip to content</a>

    <header class="royal-header">
        <nav class="navbar navbar-expand-lg royal-navbar" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand royal-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-buildings"></i></span>
                    <span class="brand-text">
                        <span class="brand-name">BookMyVilla</span>
                        <small class="brand-tagline">Luxury stays &amp; experiences</small>
                    </span>
                </a>

                <button class="navbar-toggler royal-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#royalNavbar"
                        aria-controls="royalNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="royalNavbar">
                    <ul class="navbar-nav mx-auto royal-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Home
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Villa" asp-action="Index">
                                    <i class="bi bi-buildings me-1"></i>Villa management
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center royal-account">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle account-link" href="#" id="accountDropdown"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle account-icon me-1"></i><span>@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end royal-dropdown" aria-labelledby="accountDropdown">
                                    <li><span class="dropdown-header">My account</span></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Auth" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>Log out
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link login-link" asp-controller="Auth" asp-action="Login">Log in</a>
                            </li>
                            <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                                <a class="btn royal-register-btn" asp-controller="Auth" asp-action="Register">
                                    <i class="bi bi-person-plus me-2"></i>Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main" role="main" class="royal-main">@RenderBody()</main>

    <footer class="royal-footer">
        <div class="container">
            <div class="row align-items-center gy-3">
                <div class="col-md-6 text-center text-md-start">
                    <a class="footer-brand" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-buildings me-2"></i>BookMyVilla
                    </a>
                    <p class="footer-description mb-0">Your comfort, our priority.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <span class="footer-copyright">&copy; @DateTime.Now.Year BookMyVilla. All rights reserved.</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("Styles", required: false)
</body>
</html>
