
@{
    ViewData["Title"] = "Page Not Found | RoyalVilla";
}

<style>
    .rv-404-page {
        min-height: calc(100vh - 70px);
        background: #f8f6ef;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 45px 18px;
        color: #29392e;
    }

    .rv-404-card {
        width: 100%;
        max-width: 650px;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e5eae1;
        border-radius: 22px;
        text-align: center;
        box-shadow: 0 22px 65px rgba(29, 49, 35, .09);
    }

    .rv-404-header {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        padding: 35px 25px 25px;
        background: linear-gradient(140deg, #294b37, #142e21);
        color: #fff;
    }

    .rv-404-header::after {
        content: "";
        position: absolute;
        z-index: -1;
        width: 250px;
        height: 250px;
        top: -140px;
        right: -80px;
        border: 1px solid rgba(215, 190, 129, .25);
        border-radius: 50%;
        box-shadow:
            0 0 0 30px rgba(215, 190, 129, .04),
            0 0 0 65px rgba(215, 190, 129, .025);
    }

    .rv-404-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: .8rem;
        font-weight: 750;
        letter-spacing: 2.3px;
    }

    .rv-404-brand i {
        color: #c7a96b;
        font-size: 1.3rem;
    }

    .rv-404-number {
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(6rem, 17vw, 9.5rem);
        line-height: 1;
        font-weight: 400;
        letter-spacing: -7px;
        margin: 28px 0 0;
        color: #f7f5ec;
        text-shadow: 0 8px 30px rgba(0,0,0,.15);
    }

    .rv-404-number span {
        color: #d6c18f;
    }

    .rv-404-body {
        padding: 38px clamp(22px, 6vw, 55px) 43px;
    }

    .rv-404-eyebrow {
        color: #8b9888;
        font-size: .69rem;
        font-weight: 750;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .rv-404-title {
        font-family: Georgia, "Times New Roman", serif;
        color: #193b2b;
        font-size: clamp(1.9rem, 5vw, 2.65rem);
        font-weight: 400;
        letter-spacing: -.7px;
        margin-bottom: 15px;
    }

    .rv-404-description {
        max-width: 420px;
        margin: 0 auto 27px;
        color: #7b877c;
        font-size: .92rem;
        line-height: 1.85;
    }

    .rv-404-note {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px;
        margin-bottom: 25px;
        border: 1px solid #e9ede5;
        border-radius: 12px;
        background: #f6f7f2;
        text-align: left;
    }

    .rv-404-note i {
        color: #70876f;
        font-size: 1.1rem;
        margin-top: 2px;
    }

    .rv-404-note p {
        color: #7b877c;
        font-size: .81rem;
        line-height: 1.7;
        margin: 0;
    }

    .rv-404-home {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        min-height: 51px;
        padding: 13px 20px;
        background: #294b37;
        color: #fff;
        border: 1px solid #294b37;
        border-radius: 10px;
        font-size: .9rem;
        font-weight: 700;
        text-decoration: none;
        transition: .2s ease;
    }

    .rv-404-home:hover {
        background: #193627;
        border-color: #193627;
        color: #fff;
        transform: translateY(-1px);
    }

    .rv-404-home i:last-child {
        margin-left: auto;
    }

    .rv-404-back {
        display: inline-block;
        margin-top: 20px;
        color: #527057;
        font-size: .85rem;
        font-weight: 650;
        text-decoration: none;
    }

    .rv-404-back:hover {
        color: #193b2b;
        text-decoration: underline;
    }

    .rv-404-footer {
        margin-top: 27px;
        color: #9ba49a;
        font-size: .72rem;
    }

    @@media (max-width: 575.98px) {
        .rv-404-page {
            padding: 25px 12px;
        }

        .rv-404-header {
            padding-top: 28px;
        }

        .rv-404-number {
            letter-spacing: -4px;
        }

        .rv-404-body {
            padding: 30px 22px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .rv-404-home {
            transition: none;
        }
    }
</style>

<div class="rv-404-page">
    <section class="rv-404-card">

        <div class="rv-404-header">
            <div class="rv-404-brand">
                <i class="bi bi-house-heart"></i>
                ROYALVILLA
            </div>

            <div class="rv-404-number">
                4<span>0</span>4
            </div>
        </div>

        <div class="rv-404-body">

            <div class="rv-404-eyebrow">
                A LITTLE DETOUR
            </div>

            <h1 class="rv-404-title">
                This page has wandered off.
            </h1>

            <p class="rv-404-description">
                The villa or page you're looking for may have moved,
                been removed, or never existed. Let's help you find
                your way back.
            </p>

            <div class="rv-404-note">
                <i class="bi bi-compass"></i>
                <p>
                    <strong class="d-block mb-1" style="color:#344a38;">
                        Don't worry, you're not lost.
                    </strong>
                    Return to our villa collection and continue
                    exploring your next getaway.
                </p>
            </div>

            <a asp-controller="Home"
               asp-action="Index"
               class="rv-404-home">
                <i class="bi bi-house-door"></i>
                Back to Villas
                <i class="bi bi-arrow-right"></i>
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               class="rv-404-back">
                <i class="bi bi-arrow-left me-1"></i>
                Return to the home page
            </a>

            <div class="rv-404-footer">
                <i class="bi bi-stars me-1"></i>
                RoyalVilla · Find your comfort
            </div>

        </div>
    </section>
</div>
