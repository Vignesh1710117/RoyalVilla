@using RoyalVilla.DTO
@using RoyalVillaWeb
@model IEnumerable<VillaDTO>

@{
    ViewData["Title"] = "Villa Management";
    var villas = Model?.ToList() ?? new List<VillaDTO>();
}

<style>
    .villa-dashboard {
        background: #f5f6f2;
        min-height: 100vh;
        padding: 42px 0 60px;
        color: #263b2e;
    }

    .dashboard-eyebrow {
        color: #718474;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 1.8px;
        text-transform: uppercase;
    }

    .dashboard-title {
        color: #243d2e;
        font-size: clamp(2rem, 4vw, 2.65rem);
        font-weight: 750;
        letter-spacing: -1.2px;
    }

    .dashboard-subtitle {
        color: #818a81;
    }

    .btn-add-villa {
        background: #284b36;
        color: white;
        border: 1px solid #284b36;
        border-radius: 11px;
        padding: 12px 18px;
        font-weight: 600;
    }

        .btn-add-villa:hover {
            background: #1d3828;
            color: white;
        }

    .dashboard-card {
        background: #fff;
        border: 1px solid #e7ebe4;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(35, 56, 42, .045);
        overflow: hidden;
    }

    .villa-table {
        margin-bottom: 0;
        vertical-align: middle;
    }

        .villa-table thead th {
            background: #f7f8f5;
            color: #778378;
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            padding: 17px 16px;
            border-bottom: 1px solid #e8ece5;
            white-space: nowrap;
        }

        .villa-table tbody td {
            padding: 16px;
            border-color: #edf0eb;
        }

        .villa-table tbody tr:hover {
            background: #fafbf8;
        }

    .villa-thumb {
        width: 76px;
        height: 58px;
        object-fit: cover;
        border-radius: 10px;
        background: #edf0e9;
    }

    .villa-name {
        color: #2d4635;
        font-weight: 700;
    }

    .villa-description {
        color: #838b83;
        font-size: .86rem;
        line-height: 1.5;
        min-width: 180px;
        max-width: 270px;
    }

    .price-badge {
        display: inline-block;
        padding: 7px 10px;
        border-radius: 8px;
        background: #edf5ed;
        color: #2f6540;
        font-weight: 700;
        white-space: nowrap;
    }

    .villa-meta {
        color: #536557;
        white-space: nowrap;
    }

    .action-btn {
        width: 35px;
        height: 35px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 9px;
    }

    .stats-heading {
        font-size: 1.2rem;
        font-weight: 750;
        color: #2a4031;
    }

    .stat-card {
        height: 100%;
        background: #fff;
        border: 1px solid #e7ebe4;
        border-radius: 16px;
        padding: 23px;
        box-shadow: 0 8px 25px rgba(35, 56, 42, .035);
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        font-size: 1.3rem;
        background: #edf4eb;
        color: #376347;
    }

    .stat-value {
        font-size: 1.75rem;
        font-weight: 750;
        letter-spacing: -.6px;
        color: #294533;
        margin: 15px 0 3px;
    }

    .stat-label {
        color: #858d85;
        font-size: .88rem;
    }

    .empty-state {
        padding: 65px 20px;
        text-align: center;
    }

    .empty-icon {
        font-size: 3rem;
        color: #739078;
    }

    @@media (max-width: 767px) {
        .villa-dashboard {
            padding-top: 28px;
        }

        .dashboard-header {
            align-items: flex-start !important;
            flex-direction: column;
            gap: 20px;
        }

        .btn-add-villa {
            width: 100%;
        }
    }
</style>

<div class="villa-dashboard">
    <div class="container">

        <!-- Dashboard header -->
        <div class="dashboard-header d-flex justify-content-between
            align-items-center mb-4 mb-lg-5">

            <div>
                <div class="dashboard-eyebrow mb-2">
                    ROYALVILLA · ADMINISTRATION
                </div>

                <h1 class="dashboard-title mb-2">
                    Villa Management
                </h1>

                <p class="dashboard-subtitle mb-0">
                    Manage your properties, pricing and occupancy.
                </p>
            </div>

            <a asp-controller="Villa"
               asp-action="Create"
               class="btn btn-add-villa">
                <i class="bi bi-plus-lg me-2"></i>
                Add New Villa
            </a>
        </div>

        <!-- Notifications -->
        @if (TempData["success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show
                rounded-3 border-0 shadow-sm"
                 role="alert">
                <i class="bi bi-check-circle me-2"></i>
                @TempData["success"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show
                rounded-3 border-0 shadow-sm"
                 role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @TempData["error"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        @if (villas.Count == 0)
        {
            <div class="dashboard-card empty-state">
                <i class="bi bi-houses empty-icon"></i>

                <h3 class="mt-3 fw-bold">No villas yet</h3>

                <p class="text-muted mb-4">
                    Add your first villa to start managing your listings.
                </p>

                <a asp-controller="Villa"
                   asp-action="Create"
                   class="btn btn-add-villa">
                    <i class="bi bi-plus-lg me-2"></i>
                    Create Your First Villa
                </a>
            </div>
        }
        else
        {
            <!-- Villa listing -->
            <div class="dashboard-card mb-5">
                <div class="p-4 d-flex justify-content-between
                    align-items-center flex-wrap gap-2">

                    <div>
                        <h2 class="stats-heading mb-1">
                            All Properties
                        </h2>
                        <p class="dashboard-subtitle mb-0">
                            Your current villa listings
                        </p>
                    </div>

                    <span class="price-badge">
                        @villas.Count @(villas.Count == 1 ? "Villa" : "Villas")
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover villa-table">
                        <thead>
                            <tr>
                                <th>Property</th>
                                <th>Villa Details</th>
                                <th>Rate / Night</th>
                                <th>Guests</th>
                                <th>Area</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var villa in villas)
                            {
                                <tr>
                                    <td>
                                        <img src="@SD.getImageURL(villa.ImageUrl)"
                                             alt="@villa.Name"
                                             class="villa-thumb" />
                                    </td>

                                    <td>
                                        <div class="villa-name mb-1">
                                            @villa.Name
                                        </div>

                                        <div class="villa-description">
                                            @if (string.IsNullOrWhiteSpace(villa.Details))
                                            {
                                                <span class="fst-italic">
                                                    No details available
                                                </span>
                                            }
                                            else
                                            {
                                                @(villa.Details.Length > 65
                                                    ? villa.Details.Substring(0, 65) + "..."
                                                    : villa.Details)
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <span class="price-badge">
                                            ₹@villa.Rate.ToString("N0")
                                        </span>
                                    </td>

                                    <td class="villa-meta">
                                        <i class="bi bi-people me-1"></i>
                                        @villa.Occupancy
                                    </td>

                                    <td class="villa-meta">
                                        <i class="bi bi-arrows-fullscreen me-1"></i>
                                        @villa.Sqft.ToString("N0") sq.ft.
                                    </td>

                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-controller="Villa"
                                               asp-action="Edit"
                                               asp-route-id="@villa.Id"
                                               class="btn btn-outline-success
                                                btn-sm action-btn"
                                               title="Edit villa"
                                               aria-label="Edit villa">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <a asp-controller="Villa"
                                               asp-action="Delete"
                                               asp-route-id="@villa.Id"
                                               class="btn btn-outline-danger
                                                btn-sm action-btn"
                                               title="Delete villa"
                                               aria-label="Delete villa">
                                                <i class="bi bi-trash3"></i>
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Summary -->
            <div class="mb-4">
                <div class="mb-3">
                    <div class="dashboard-eyebrow mb-2">
                        PROPERTY OVERVIEW
                    </div>
                    <h2 class="stats-heading mb-0">At a glance</h2>
                </div>

                <div class="row g-3">

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card">
                            <div class="stat-icon">
                                <i class="bi bi-house-heart"></i>
                            </div>

                            <div class="stat-value">
                                @villas.Count
                            </div>

                            <div class="stat-label">
                                Total Villas
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card">
                            <div class="stat-icon">
                                <i class="bi bi-cash-stack"></i>
                            </div>

                            <div class="stat-value">
                                ₹@villas.Min(v => v.Rate).ToString("N0")
                            </div>

                            <div class="stat-label">
                                Starting Price / Night
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card">
                            <div class="stat-icon">
                                <i class="bi bi-people"></i>
                            </div>

                            <div class="stat-value">
                                @villas.Max(v => v.Occupancy)
                            </div>

                            <div class="stat-label">
                                Highest Guest Capacity
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="stat-card">
                            <div class="stat-icon">
                                <i class="bi bi-bounding-box"></i>
                            </div>

                            <div class="stat-value">
                                @villas.Sum(v => v.Sqft).ToString("N0")
                            </div>

                            <div class="stat-label">
                                Combined Area (sq.ft.)
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>
