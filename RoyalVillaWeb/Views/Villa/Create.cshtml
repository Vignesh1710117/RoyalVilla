
@model RoyalVilla.DTO.VillaCreateDTO
@using RoyalVillaWeb

@{
    ViewData["Title"] = "Create Villa";
}

<style>
    .villa-create-page {
        background: #f5f6f2;
        min-height: 100vh;
        padding: 42px 0 60px;
        color: #263b2e;
    }

    .create-eyebrow {
        color: #718474;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 1.8px;
        text-transform: uppercase;
    }

    .create-title {
        color: #243d2e;
        font-size: clamp(2rem, 4vw, 2.55rem);
        font-weight: 750;
        letter-spacing: -1px;
    }

    .create-subtitle {
        color: #818a81;
    }

    .create-card {
        background: #fff;
        border: 1px solid #e6ebe4;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(35, 56, 42, .055);
    }

    .create-card-header {
        background: #294b37;
        color: #fff;
        padding: 23px 28px;
    }

    .create-card-header h2 {
        font-size: 1.15rem;
        font-weight: 700;
        margin: 0;
    }

    .create-card-body {
        padding: clamp(22px, 4vw, 36px);
    }

    .create-section-label {
        color: #708273;
        font-size: .73rem;
        font-weight: 750;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 18px;
    }

    .villa-create-page .form-label {
        color: #394a3e;
        font-size: .88rem;
        font-weight: 650;
        margin-bottom: 8px;
    }

    .villa-create-page .form-control {
        border: 1px solid #dfe5dc;
        background: #fbfcfa;
        border-radius: 10px;
        min-height: 46px;
        padding: 11px 13px;
        color: #263b2e;
    }

    .villa-create-page textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .villa-create-page .form-control:focus {
        border-color: #557c61;
        box-shadow: 0 0 0 .2rem rgba(64, 111, 78, .12);
        background: #fff;
    }

    .villa-create-page .input-group-text {
        background: #edf3eb;
        border-color: #dfe5dc;
        color: #31563c;
        border-radius: 10px 0 0 10px;
        font-weight: 650;
    }

    .villa-create-page .input-group .form-control {
        border-radius: 0 10px 10px 0;
    }

    .create-divider {
        border: 0;
        border-top: 1px solid #edf0eb;
        margin: 27px 0;
    }

    .image-upload-box {
        background: #f7f9f5;
        border: 1px dashed #cbd7c9;
        border-radius: 14px;
        padding: 22px;
    }

    .image-upload-icon {
        color: #63836a;
        font-size: 1.8rem;
    }

    .create-help {
        color: #858e85;
        font-size: .82rem;
    }

    .btn-create-villa {
        background: #294b37;
        color: #fff;
        border: 1px solid #294b37;
        border-radius: 10px;
        padding: 12px 21px;
        font-weight: 650;
    }

    .btn-create-villa:hover {
        background: #1d3828;
        border-color: #1d3828;
        color: #fff;
    }

    .btn-cancel-villa {
        background: #fff;
        color: #42594a;
        border: 1px solid #dce3da;
        border-radius: 10px;
        padding: 12px 20px;
        font-weight: 600;
    }

    .btn-cancel-villa:hover {
        background: #f3f6f1;
        color: #263d2e;
    }

    #preview {
        width: 100%;
        max-width: 420px;
        max-height: 300px;
        object-fit: cover;
        border-radius: 12px;
    }

    @@media (max-width: 575px) {
        .villa-create-page {
            padding-top: 28px;
        }

        .create-card-header,
        .create-card-body {
            padding: 21px;
        }
    }
</style>

<div class="villa-create-page">
    <div class="container">

        <!-- Page heading -->
        <div class="mb-4 mb-lg-5">
            <div class="create-eyebrow mb-2">
                ROYALVILLA · PROPERTY MANAGEMENT
            </div>

            <h1 class="create-title mb-2">
                Create New Villa
            </h1>

            <p class="create-subtitle mb-0">
                Add a property to your collection and configure its details.
            </p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8">

                <div class="create-card">

                    <div class="create-card-header d-flex
                                align-items-center gap-3">
                        <i class="bi bi-house-add fs-4"></i>

                        <div>
                            <h2>Villa information</h2>
                            <small class="text-white-50">
                                Enter the details for your new property.
                            </small>
                        </div>
                    </div>

                    <div class="create-card-body">

                        <form method="post" enctype="multipart/form-data">

                            <div class="create-section-label">
                                01 &nbsp; Basic information
                            </div>

                            <div class="mb-4">
                                <label asp-for="Name" class="form-label">
                                    Villa Name <span class="text-danger">*</span>
                                </label>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Enter villa name" />

                                <span asp-validation-for="Name"
                                      class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Details" class="form-label">
                                    Description
                                </label>

                                <textarea asp-for="Details"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Describe the villa, its features and surroundings"></textarea>

                                <span asp-validation-for="Details"
                                      class="text-danger small"></span>
                            </div>

                            <hr class="create-divider" />

                            <div class="create-section-label">
                                02 &nbsp; Pricing and capacity
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Rate" class="form-label">
                                        Nightly Rate <span class="text-danger">*</span>
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">₹</span>

                                        <input asp-for="Rate"
                                               type="number"
                                               step="0.01"
                                               min="0"
                                               class="form-control"
                                               placeholder="0.00" />
                                    </div>

                                    <span asp-validation-for="Rate"
                                          class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Occupancy"
                                           class="form-label">
                                        Maximum Occupancy
                                    </label>

                                    <input asp-for="Occupancy"
                                           type="number"
                                           min="1"
                                           class="form-control"
                                           placeholder="Number of guests" />

                                    <span asp-validation-for="Occupancy"
                                          class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="Sqft" class="form-label">
                                        Property Area
                                    </label>

                                    <div class="input-group">
                                        <input asp-for="Sqft"
                                               type="number"
                                               min="0"
                                               class="form-control"
                                               placeholder="Enter area" />

                                        <span class="input-group-text">
                                            sq.ft.
                                        </span>
                                    </div>

                                    <span asp-validation-for="Sqft"
                                          class="text-danger small"></span>
                                </div>
                            </div>

                            <hr class="create-divider" />

                            <div class="create-section-label">
                                03 &nbsp; Property images
                            </div>

                            <div class="image-upload-box">
                                <div class="text-center mb-3">
                                    <i class="bi bi-cloud-arrow-up image-upload-icon"></i>

                                    <h6 class="fw-bold mt-2 mb-1">
                                        Upload villa image
                                    </h6>

                                    <p class="create-help mb-0">
                                        Choose an image from your device.
                                    </p>
                                </div>

                                <label asp-for="Image" class="form-label">
                                    Villa Image
                                </label>

                                <input asp-for="Image"
                                       type="file"
                                       class="form-control"
                                       accept="image/jpeg,image/png"
                                       onchange="previewImage(this)" />

                                <span asp-validation-for="Image"
                                      class="text-danger small"></span>

                                <div class="create-help mt-2">
                                    Supported formats: JPG, JPEG, PNG.
                                    Maximum size: 5 MB.
                                </div>

                                <div id="imagePreview"
                                     class="mt-4 text-center"
                                     style="display:none">

                                    <p class="fw-semibold mb-3">
                                        Image preview
                                    </p>

                                    <img id="preview"
                                         alt="Selected villa image preview" />
                                </div>
                            </div>

                            <div class="mt-4">
                                <label asp-for="ImageUrl" class="form-label">
                                    Image URL <span class="text-muted">(Optional)</span>
                                </label>

                                <input asp-for="ImageUrl"
                                       class="form-control"
                                       placeholder="https://example.com/image.jpg" />

                                <span asp-validation-for="ImageUrl"
                                      class="text-danger small"></span>
                            </div>

                            <hr class="create-divider" />

                            <div class="d-flex flex-column flex-sm-row
                                        justify-content-end gap-3">

                                <a asp-action="Index"
                                   class="btn btn-cancel-villa">
                                    <i class="bi bi-arrow-left me-2"></i>
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="btn btn-create-villa">
                                    <i class="bi bi-check2-circle me-2"></i>
                                    Create Villa
                                </button>

                            </div>

                        </form>
                    </div>
                </div>

                <p class="text-center create-help mt-3">
                    Review the property information before creating the listing.
                </p>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function previewImage(input) {
            const previewContainer =
                document.getElementById('imagePreview');

            const preview =
                document.getElementById('preview');

            if (input.files && input.files[0]) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    preview.src = e.target.result;
                    previewContainer.style.display = 'block';
                };

                reader.readAsDataURL(input.files[0]);
            } else {
                preview.src = '';
                previewContainer.style.display = 'none';
            }
        }
    </script>
}
